<%- include("header") %>

            <form action="/editProductPost/<%= prod._id %>" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-6">
                    <div class="content-header">
                        <h2 class="content-title">Edit Product</h2>
                        <div>
                            <button class="btn btn-md rounded font-sm hover-up" onclick="return validateForm(event)">Edit</button>
                            <span id="submit-error"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3"><h6>1. General info</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Product title</label>
                                        <input type="text" placeholder="Type here" id="product_name" class="form-control" name="title" value="<%= prod.title %>" onkeyup="validateName()">
                                        <span id="name-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Description</label>
                                        <input placeholder="Type here" id="product_description" type="text" class="form-control" name="description" value="<%= prod.description %>" onkeyup="validateDescription()">
                                        <span id="description-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Fabric</label>
                                        <input placeholder="Type here" id="product_fabric" class="form-control" name="fabric" value="<%= prod.fabric %>" onkeyup="validateFabric()">
                                        <span id="fabric-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Color</label>
                                        <input placeholder="Type here" id="product_color" class="form-control" name="color" value="<%= prod.color %>" onkeyup="validateColor()">
                                        <span id="color-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Style</label>
                                        <input placeholder="Type here" id="product_style" class="form-control" name="style" value="<%= prod.style %>" onkeyup="validateStyle()">
                                        <span id="style-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">OldPrice</label>
                                        <input placeholder="Type here" id="product_oldprice" class="form-control" name="oldPrice" value="<%= prod.oldPrice %>" onkeyup="validateOldPrice()">
                                        <span id="oldprice-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Stock</label>
                                        <input placeholder="Type here" id="product_stock" class="form-control" name="stock" value="<%= prod.stock %>" onkeyup="validateStock()">
                                        <span id="stock-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label" for="sizeStock">Size</label><br>
                                        <% prod.variants.forEach(variant => { %>
                                            <label class="form-label"><%= variant.size %></label>
                                            <input placeholder="Enter the stock" class="form-control" name="<%= variant.size %>stock" value="<%= variant.stock %>">
                                        <% }) %>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Offer</label>
                                        <input placeholder="Type here" class="form-control" name="offer" value="<%= prod.offer %>">
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Brand name</label>
                                        <select class="form-select" name="brand">
                                            <% brands.forEach(row => { %>
                                                <option value="<%= row._id %>"> <%= row.brand %> </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3"><h6>2. Pricing</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Cost in INR</label>
                                        <input type="text" placeholder="₹00.0" id="product_price" class="form-control" name="price" value="<%= prod.price %>" onkeyup="validatePrice()">
                                        <span id="price-error"></span>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3"><h6>3. Category</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Category</label>
                                        <select class="form-select" name="category">
                                            <% cate.forEach(row => { %>
                                                <option value="<%= row._id %>"> <%= row.category %> </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3"><h6>4. Media</h6></div>
                                <div class="col-md-9 existing-images">
                                    <% if (prod.images && prod.images.length > 0) { %>
                                    <div class="image-container">
                                        <% prod.images.forEach((imageUrl, index) => { %>
                                            <div class="image-preview">
                                              <img src="/static/uploads/<%= imageUrl %>" alt="Existing Image" class="existing-image">
                                              <i class="fa-solid fa-repeat replace-image-icon" data-index="<%= index %>"></i>
                                              <i class="fa-solid fa-trash delete-image-btn" data-index="<%= index %>"></i>
                                            </div>
                                          <% }) %>
                                    </div>
                                    <% }else{ %>
                                        <p>No existing images</p>
                                    <% } %>
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label">New Images</label>
                                <input class="form-control" type="file" name="images" id="product_image" multiple onkeyup="validateImage()">
                                <span id="image-error"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </form>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<script>
    // Handle replacement of images
    document.querySelectorAll('.replace-image-icon').forEach(icon => {
      icon.addEventListener('click', function () {
        const index = this.dataset.index;
        const fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/*';
        fileInput.onchange = function (event) {
          const file = event.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
              const imagePreview = document.querySelector(`.existing-images .image-container .image-preview:nth-child(${parseInt(index) + 1}) img`);
              imagePreview.src = e.target.result;
              updateFileInput(file, index);
            };
            reader.readAsDataURL(file);
          }
        };
        fileInput.click();
      });
    });

    function updateFileInput(file, index) {
      const fileInput = document.getElementById('product_image');
      const fileList = new DataTransfer();
      fileList.items.add(file);
      fileInput.files = fileList.files;
    }

    window.addEventListener('DOMContentLoaded', function () {
      const existingImages = document.querySelectorAll('.existing-images img');
      const fileInput = document.getElementById('product_image');
      const fileList = new DataTransfer();
      existingImages.forEach(function (image) {
        const url = image.getAttribute('src');
        const filename = url.substring(url.lastIndexOf('/') + 1);
        fetch(url).then(r => r.blob()).then(blob => {
          fileList.items.add(new File([blob], filename, { type: blob.type }));
          fileInput.files = fileList.files;
        });
      });
    });

    document.querySelectorAll('.delete-image-btn').forEach(button => {
      button.addEventListener('click', function () {
        this.parentElement.remove();
        updateAllFiles();
      });
    });

    function updateAllFiles() {
      const fileInput = document.getElementById('product_image');
      const existingImages = document.querySelectorAll('.existing-images img');
      const fileList = new DataTransfer();
      existingImages.forEach(function (image) {
        const url = image.getAttribute('src');
        const filename = url.substring(url.lastIndexOf('/') + 1);
        fetch(url).then(r => r.blob()).then(blob => {
          fileList.items.add(new File([blob], filename, { type: blob.type }));
          fileInput.files = fileList.files;
        });
      });
      if (existingImages.length === 0) fileInput.value = '';
    }

    var nameError = document.getElementById("name-error");
    var descriptionError = document.getElementById("description-error");
    var priceError = document.getElementById("price-error");
    var imageError = document.getElementById("image-error");
    var stockError = document.getElementById("stock-error");
    var submitError = document.getElementById("submit-error");
    var fabricError = document.getElementById("fabric-error");
    var colorError = document.getElementById("color-error");
    var styleError = document.getElementById("style-error");
    var oldpriceError = document.getElementById("oldprice-error");

    function validateName() { var v=document.getElementById("product_name").value.trim(); if(!v){nameError.innerHTML="Required";nameError.style.color="red";return false;} nameError.innerHTML="Valid";nameError.style.color="green";return true; }
    function validateFabric() { var v=document.getElementById("product_fabric").value.trim(); if(!v){fabricError.innerHTML="Required";fabricError.style.color="red";return false;} fabricError.innerHTML="Valid";fabricError.style.color="green";return true; }
    function validateColor() { var v=document.getElementById("product_color").value.trim(); if(!v){colorError.innerHTML="Required";colorError.style.color="red";return false;} colorError.innerHTML="Valid";colorError.style.color="green";return true; }
    function validateStyle() { var v=document.getElementById("product_style").value.trim(); if(!v){styleError.innerHTML="Required";styleError.style.color="red";return false;} styleError.innerHTML="Valid";styleError.style.color="green";return true; }
    function validateDescription() { var v=document.getElementById("product_description").value.trim(); if(!v){descriptionError.innerHTML="Required";descriptionError.style.color="red";return false;} descriptionError.innerHTML="Valid";descriptionError.style.color="green";return true; }
    function validatePrice() { var v=document.getElementById("product_price").value.trim(); if(!v||isNaN(v)||parseFloat(v)<=0){priceError.innerHTML="Must be positive";priceError.style.color="red";return false;} priceError.innerHTML="Valid";priceError.style.color="green";return true; }
    function validateOldPrice() { var v=document.getElementById("product_oldprice").value.trim(); if(!v||isNaN(v)||parseFloat(v)<=0){oldpriceError.innerHTML="Must be positive";oldpriceError.style.color="red";return false;} oldpriceError.innerHTML="Valid";oldpriceError.style.color="green";return true; }
    function validateStock() { var v=document.getElementById("product_stock").value.trim(); if(!v||isNaN(v)||parseInt(v)<0){stockError.innerHTML="Must be non-negative";stockError.style.color="red";return false;} stockError.innerHTML="Valid";stockError.style.color="green";return true; }
    function validateImage() { var i=document.getElementById("product_image"); if(i.files.length===0){imageError.innerHTML="Required";imageError.style.color="red";return false;} imageError.innerHTML="Valid";imageError.style.color="green";return true; }

    function validateForm(event) {
      var ok = validateName() && validateDescription() && validatePrice() && validateStock() && validateFabric() && validateColor() && validateStyle() && validateOldPrice();
      if (!ok) { event.preventDefault(); submitError.innerHTML="Please fill all fields"; submitError.style.color="red"; setTimeout(()=>{submitError.innerHTML=""},3000); }
    }
</script>

<%- include("footer") %>