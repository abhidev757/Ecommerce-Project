<%- include("header") %>

            <div class="content-header">
                <div>
                    <h2 class="content-title card-title">Category</h2>
                </div>
                <div>
                    <a href="/addCategory" class="btn btn-primary btn-sm rounded">Create new</a>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-body">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% Data.forEach((row,index) => { %>
                            <tr>
                                <td><%= row.category %></td>
                                <td><%= row.description %></td>
                                <td>
                                    <% if (row.isListed) { %>
                                        <span class="badge rounded-pill alert-success">Listed</span>
                                    <% } else { %>
                                        <span class="badge rounded-pill alert-danger">Unlisted</span>
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/editCategory/<%= row._id %>" class="btn btn-sm font-sm rounded btn-brand">
                                        <i class="material-icons md-edit"></i> Edit
                                    </a>
                                    <% if (row.isListed) { %>
                                        <a href="#" onclick="confirmUnlist('<%= row._id %>')" class="btn btn-sm font-sm rounded btn-brand">
                                            <i class="material-icons md-edit"></i> Unlist
                                        </a>
                                    <% } else { %>
                                        <a href="#" onclick="confirmList('<%= row._id %>')" class="btn btn-sm font-sm rounded btn-brand">
                                            <i class="material-icons md-edit"></i> List
                                        </a>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmUnlist(prodId) {
         Swal.fire({
           title: "Are you sure?",
           text: "You want to UnList this product?",
           icon: "warning",
           showCancelButton: true,
           confirmButtonColor: "#d33",
           cancelButtonColor: "#3085d6",
           confirmButtonText: "Yes, UnList it!",
         }).then((result) => {
           if (result.isConfirmed) {
             window.location.href = "/unlist/" + prodId;
           }
         });
       }
    function confirmList(prodId) {
         Swal.fire({
           title: "Are you sure?",
           text: "You want to list this product?",
           icon: "warning",
           showCancelButton: true,
           confirmButtonColor: "#d33",
           cancelButtonColor: "#3085d6",
           confirmButtonText: "Yes, list it!",
         }).then((result) => {
           if (result.isConfirmed) {
             window.location.href = "/list/" + prodId;
           }
         });
       }
</script>

<%- include("footer") %>