<%- include("header") %>

            <div class="content-header">
                <div>
                    <h2 class="content-title card-title">Coupons List</h2>
                </div>
                <div>
                    <a href="/addCoupon" class="btn btn-primary btn-sm rounded">Create new</a>
                </div>
            </div>
            <div class="card mb-4">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Coupon Code</th>
                            <th scope="col">Description</th>
                            <th scope="col">%</th>
                            <th scope="col">Upto</th>
                            <th scope="col">Min Amount</th>
                            <th scope="col">Expiry Date</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% data.forEach((row, index) => { %>
                        <tr>
                            <td><%= row.couponCode %></td>
                            <td><%= row.description %></td>
                            <td><%= row.discountPercentage %></td>
                            <td><%= row.maxDiscountAmount %></td>
                            <td><%= row.minAmount %></td>
                            <td><%= new Date(row.expiryDate).toLocaleDateString() %></td>
                            <td>
                                <% if (row.isListed) { %>
                                <span class="badge rounded-pill alert-success">Listed</span>
                                <% } else { %>
                                <span class="badge rounded-pill alert-danger">Unlisted</span>
                                <% } %>
                            </td>
                            <td>
                                <a href="/editCoupon/<%= row._id %>" class="btn btn-sm font-sm rounded btn-brand">
                                    <i class="material-icons md-edit"></i> Edit
                                </a>
                                <% if (row.isListed) { %>
                                <a href="#" onclick="confirmUnlist('<%= row._id %>')" class="btn btn-sm font-sm rounded btn-brand">
                                    <i class="material-icons md-edit"></i> Unlist
                                </a>
                                <% } else { %>
                                <a href="#" onclick="confirmList('<%= row._id %>')" class="btn btn-sm font-sm rounded btn-brand">
                                    <i class="material-icons md-edit"></i> List
                                </a>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmUnlist(coupId) {
         Swal.fire({
           title: "Are you sure?",
           text: "You want to UnList this coupon?",
           icon: "warning",
           showCancelButton: true,
           confirmButtonColor: "#d33",
           cancelButtonColor: "#3085d6",
           confirmButtonText: "Yes, UnList it!",
         }).then((result) => {
           if (result.isConfirmed) {
             window.location.href = "/couponUnlist/" + coupId;
           }
         });
       }
    function confirmList(coupId) {
         Swal.fire({
           title: "Are you sure?",
           text: "You want to list this coupon?",
           icon: "warning",
           showCancelButton: true,
           confirmButtonColor: "#d33",
           cancelButtonColor: "#3085d6",
           confirmButtonText: "Yes, list it!",
         }).then((result) => {
           if (result.isConfirmed) {
             window.location.href = "/couponList/" + coupId;
           }
         });
       }
</script>

<%- include("footer") %>