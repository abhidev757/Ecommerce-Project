<%- include("header") %>

            <form action="/editCouponPost/<%=coupon._id %>" method="post">
            <div class="row">
                <div class="col-6">
                    <div class="content-header">
                        <h2 class="content-title">Edit Coupon</h2>
                        <div>
                            <button class="btn btn-md rounded font-sm hover-up">Edit</button>
                            <span id="submit-error"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3"><h6>1. Coupon info</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Coupon Code</label>
                                        <input type="text" placeholder="Type here" id="coupon_code" class="form-control" name="couponCode" value="<%= coupon.couponCode %>" onkeyup="validateCode()">
                                        <span id="code-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Description</label>
                                        <textarea placeholder="Type here" id="coupon_description" class="form-control" rows="4" name="description" onkeyup="validateDescription()"><%= coupon.description %></textarea>
                                        <span id="description-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Discount %</label>
                                        <input placeholder="Type here" id="percentage" class="form-control" name="discount" value="<%= coupon.discountPercentage %>" onkeyup="validatePrice()">
                                        <span id="price-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Min Amount</label>
                                        <input placeholder="Type here" id="min_amount" class="form-control" name="minAmount" value="<%= coupon.minAmount %>" onkeyup="validateMinAmount()">
                                        <span id="min-amount-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Max Amount</label>
                                        <input placeholder="Type here" id="max_amount" class="form-control" name="maxAmount" value="<%= coupon.maxDiscountAmount %>" onkeyup="validateMaxAmount()">
                                        <span id="max-amount-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Expiry Date</label>
                                        <input placeholder="Type here" type="date" id="expiry_date" class="form-control" name="expiryDate" value="<%= coupon.expiryDate ? coupon.expiryDate.toISOString().substr(0, 10) : '' %>" onchange="validateDate()">
                                        <span id="date-error"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </form>

<script>
    function validateCode() { var e=document.getElementById("code-error"),v=document.getElementById("coupon_code").value.trim(); if(!/^[A-Z0-9]+$/.test(v)){e.innerHTML="Only uppercase letters and numbers";e.style.color="red";return false;} e.innerHTML="";return true; }
    function validateDescription() { var e=document.getElementById("description-error"),v=document.getElementById("coupon_description").value.trim(); if(!v){e.innerHTML="Description is required";e.style.color="red";return false;} e.innerHTML="";return true; }
    function validatePrice() { var e=document.getElementById("price-error"),v=document.getElementById("percentage").value.trim(); if(!v||isNaN(v)||parseFloat(v)<=0||parseFloat(v)>100){e.innerHTML="Must be 1–100";e.style.color="red";return false;} e.innerHTML="";return true; }
    function validateMinAmount() { var e=document.getElementById("min-amount-error"),v=document.getElementById("min_amount").value.trim(); if(!v||v<1||isNaN(v)){e.innerHTML="Invalid entry";e.style.color="red";return false;} e.innerHTML="";return true; }
    function validateMaxAmount() { var e=document.getElementById("max-amount-error"),v=document.getElementById("max_amount").value.trim(); if(!v||v<1||isNaN(v)){e.innerHTML="Invalid entry";e.style.color="red";return false;} e.innerHTML="";return true; }
    function validateDate() { var e=document.getElementById("date-error"),d=new Date(document.getElementById("expiry_date").value); if(d<=new Date()){e.innerHTML="Please select a future date";e.style.color="red";return false;} e.innerHTML="";return true; }
</script>

<%- include("footer") %>