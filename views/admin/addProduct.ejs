<%- include("header") %>

            <form action="/addProductPost" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-6">
                    <div class="content-header">
                        <h2 class="content-title">Add New Product</h2>
                        <div>
                            <button class="btn btn-md rounded font-sm hover-up" onclick="return validateForm()">Add</button>
                            <span id="submit-error"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3"><h6>1. General info</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Product title</label>
                                        <input type="text" placeholder="Type here" id="product_name" class="form-control" name="title" onkeyup="validateName()">
                                        <span id="name-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Description</label>
                                        <textarea placeholder="Type here" id="product_description" class="form-control" rows="4" name="description" onkeyup="validateDescription()"></textarea>
                                        <span id="description-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Fabric</label>
                                        <input placeholder="Type here" id="product_fabric" class="form-control" name="fabric" onkeyup="validateFabric()">
                                        <span id="fabric-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Color</label>
                                        <input placeholder="Type here" id="product_color" class="form-control" name="color" onkeyup="validateColor()">
                                        <span id="color-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Style</label>
                                        <input placeholder="Type here" id="product_style" class="form-control" name="style" onkeyup="validateStyle()">
                                        <span id="style-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Old Price</label>
                                        <input placeholder="Type here" id="product_oldprice" class="form-control" name="oldPrice" onkeyup="validateOldPrice()">
                                        <span id="oldprice-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Stock</label>
                                        <input placeholder="Type here" id="product_stock" class="form-control" name="stock" onkeyup="validateStock()">
                                        <span id="stock-error"></span>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Size</label><br>
                                        <label class="form-label">S</label>
                                        <input placeholder="Enter the stock" class="form-control" name="Sstock">
                                        <label class="form-label">M</label>
                                        <input placeholder="Enter the stock" class="form-control" name="Mstock">
                                        <label class="form-label">L</label>
                                        <input placeholder="Enter the stock" class="form-control" name="Lstock">
                                        <label class="form-label">XL</label>
                                        <input placeholder="Enter the stock" class="form-control" name="XLstock">
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Offer</label>
                                        <input placeholder="Type here" class="form-control" name="offer">
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label">Brand name</label>
                                        <select class="form-select" name="brand">
                                            <% brands.forEach(row => { %>
                                                <option value="<%= row._id %>"> <%= row.brand %> </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3"><h6>2. Pricing</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Cost in INR</label>
                                        <input type="text" id="product_price" placeholder="₹00.0" class="form-control" name="price" onkeyup="validatePrice()">
                                        <span id="price-error"></span>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3"><h6>3. Category</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Category</label>
                                        <select class="form-select" name="category">
                                            <% cate.forEach(row => { %>
                                                <option value="<%= row._id %>"> <%= row.category %> </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <hr class="mb-4 mt-0">
                            <div class="row">
                                <div class="col-md-3"><h6>4. Media</h6></div>
                                <div class="col-md-9">
                                    <div class="mb-4">
                                        <label class="form-label">Images</label>
                                        <input class="form-control" name="images" id="product_image" type="file" multiple accept="image/png, image/jpeg, image/webp" onchange="previewImages(event)" />
                                        <span id="image-error" style="font-size: 14px; margin-top: -20px"></span>
                                        <button class="btn btn-secondary mt-2" id="crop-button" style="display: none;" onclick="confirmCrop()">Confirm</button>
                                    </div>
                                    <div id="image-preview" class="mb-4"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </form>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
<script>
    function previewImages(event) {
      const previewContainer = document.getElementById("image-preview");
      previewContainer.innerHTML = "";
      const files = event.target.files;
      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const reader = new FileReader();
        reader.onload = function (e) {
          const img = document.createElement("img");
          img.src = e.target.result;
          img.classList.add("img-preview");
          const deleteIcon = document.createElement("i");
          deleteIcon.className = "fa-solid fa-trash text-danger";
          deleteIcon.onclick = function () { this.parentNode.remove(); updateSelectedFiles(); };
          const replaceIcon = document.createElement("i");
          replaceIcon.className = "fa-solid fa-repeat text-success ms-2";
          replaceIcon.onclick = function () {
            const index = Array.from(this.parentNode.parentNode.children).indexOf(this.parentNode);
            const fi = document.createElement('input'); fi.type='file'; fi.accept='image/*';
            fi.onchange = function(ev) { const f=ev.target.files[0]; if(f){const r=new FileReader();r.onload=function(e2){img.src=e2.target.result;updateFileInput(f,index);};r.readAsDataURL(f);} };
            fi.click();
          };
          const div = document.createElement("div");
          div.appendChild(img); div.appendChild(deleteIcon); div.appendChild(replaceIcon);
          previewContainer.appendChild(div);
        };
        reader.readAsDataURL(file);
      }
    }

    function updateSelectedFiles() {
      const filesInput = document.getElementById("product_image");
      const imgs = document.querySelectorAll('.img-preview');
      const fileList = new DataTransfer();
      imgs.forEach((img) => { const src=img.getAttribute('src'); fileList.items.add(dataURLtoFile(src,`image_${Date.now()}.png`)); });
      filesInput.files = fileList.files;
    }

    function dataURLtoFile(dataurl, filename) {
      const arr=dataurl.split(','), mime=arr[0].match(/:(.*?);/)[1], bstr=atob(arr[1]);
      let n=bstr.length; const u8arr=new Uint8Array(n);
      while(n--){u8arr[n]=bstr.charCodeAt(n);}
      return new File([u8arr],filename,{type:mime});
    }

    function updateFileInput(file, index) {
      const fi=document.getElementById('product_image'), fl=new DataTransfer(), files=fi.files;
      for(let i=0;i<files.length;i++){fl.items.add(i===index?file:files[i]);}
      fi.files=fl.files;
    }

    var nameError=document.getElementById("name-error"),descriptionError=document.getElementById("description-error"),
        priceError=document.getElementById("price-error"),imageError=document.getElementById("image-error"),
        stockError=document.getElementById("stock-error"),submitError=document.getElementById("submit-error"),
        fabricError=document.getElementById("fabric-error"),colorError=document.getElementById("color-error"),
        styleError=document.getElementById("style-error"),oldpriceError=document.getElementById("oldprice-error");

    function validateName(){var v=document.getElementById("product_name").value.trim();if(!v){nameError.innerHTML="Required";nameError.style.color="red";return false;}nameError.innerHTML="Valid";nameError.style.color="green";return true;}
    function validateFabric(){var v=document.getElementById("product_fabric").value.trim();if(!v){fabricError.innerHTML="Required";fabricError.style.color="red";return false;}fabricError.innerHTML="Valid";fabricError.style.color="green";return true;}
    function validateColor(){var v=document.getElementById("product_color").value.trim();if(!v){colorError.innerHTML="Required";colorError.style.color="red";return false;}colorError.innerHTML="Valid";colorError.style.color="green";return true;}
    function validateStyle(){var v=document.getElementById("product_style").value.trim();if(!v){styleError.innerHTML="Required";styleError.style.color="red";return false;}styleError.innerHTML="Valid";styleError.style.color="green";return true;}
    function validateDescription(){var v=document.getElementById("product_description").value.trim();if(!v){descriptionError.innerHTML="Required";descriptionError.style.color="red";return false;}descriptionError.innerHTML="Valid";descriptionError.style.color="green";return true;}
    function validatePrice(){var v=document.getElementById("product_price").value.trim();if(!v||isNaN(v)||parseFloat(v)<=0){priceError.innerHTML="Must be positive";priceError.style.color="red";return false;}priceError.innerHTML="Valid";priceError.style.color="green";return true;}
    function validateOldPrice(){var v=document.getElementById("product_oldprice").value.trim();if(!v||isNaN(v)||parseFloat(v)<=0){oldpriceError.innerHTML="Must be positive";oldpriceError.style.color="red";return false;}oldpriceError.innerHTML="Valid";oldpriceError.style.color="green";return true;}
    function validateStock(){var v=document.getElementById("product_stock").value.trim();if(!v||isNaN(v)||parseInt(v)<0){stockError.innerHTML="Must be non-negative";stockError.style.color="red";return false;}stockError.innerHTML="Valid";stockError.style.color="green";return true;}
    function validateImage(){var i=document.getElementById("product_image");if(i.files.length===0){imageError.innerHTML="Image is required";imageError.style.color="red";return false;}imageError.innerHTML="Valid";imageError.style.color="green";return true;}

    function validateForm() {
      if(!validateName()||!validateDescription()||!validatePrice()||!validateImage()||!validateStock()||!validateFabric()||!validateColor()||!validateStyle()||!validateOldPrice()){
        submitError.style.display="block";submitError.innerHTML="Please enter all the fields to submit";submitError.style.color="red";
        setTimeout(function(){submitError.style.display="none";},3000);return false;
      }
    }
</script>

<%- include("footer") %>